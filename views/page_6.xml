<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Page 6: Vision/Mission Section -->
        <template id="aura_page_6" name="AuraCenter Page 6 - Vision/Mission">
            <div class="relative flex flex-col lg:flex-row lg:justify-center items-center lg:items-start bg-no-repeat h-[100vh] w-[100vw] page-6 bg-[#F2EEEB] lg:space-x-16" id="page-6">
                <div id="missionCard" class="visionMission hover-card group absolute top-0 lg:relative w-[80vw] lg:w-[25vw] h-[80vh] lg:h-[70vh] lg:group-hover:z-[3]">
                    <div class="card__content relative transition-transform duration-1000 w-full h-full">
                        <picture id="missionImg" class="card__front cursor-pointer absolute top-0 left-0 lg:group-hover:z-[2]" style="box-shadow: 40px 85px 22px rgba(0, 0, 0, 0.25)">
                            <!-- AVIF versions -->
                            <source type="image/avif" srcset="
                                /custom_website/static/src/img/page_6/mission-640.avif 640w,
                                /custom_website/static/src/img/page_6/mission-768.avif 768w,
                                /custom_website/static/src/img/page_6/mission-1024.avif 1024w,
                                /custom_website/static/src/img/page_6/mission-1920.avif 1920w
                                " sizes="(max-width: 640px) 640px,
                                (max-width: 768px) 768px,
                                (max-width: 1024px) 1024px,
                                1920px" />
                            <!-- PNG fallback -->
                            <source type="image/png" srcset="
                                /custom_website/static/src/img/page_6/mission-640.png 640w,
                                /custom_website/static/src/img/page_6/mission-768.png 768w,
                                /custom_website/static/src/img/page_6/mission-1024.png 1024w,
                                /custom_website/static/src/img/page_6/mission-1920.png 1920w
                                " sizes="(max-width: 640px) 640px,
                                (max-width: 768px) 768px,
                                (max-width: 1024px) 1024px,
                                1920px" />
                            <!-- Fallback img with lazy loading -->
                            <img class="w-[80vw] lg:w-[25vw] h-[80vh] lg:h-[80vh] object-fill" 
                                 src="/custom_website/static/src/img/page_6/mission.png" 
                                 alt="mission" 
                                 loading="lazy" />
                        </picture>
                        <div id="mission" class="flex flex-col justify-center card__back w-[80vw] lg:w-[60vw] lg:py-10 h-[70vh] lg:h-[45vh] bottom-0 lg:bottom-[-5%] absolute bottom-0 left-0 bg-[#AAABAB] lg:opacity-0 transition-opacity duration-[600ms] ease-out shadow-[0_20px_40px_rgba(0,0,0,0.3)] will-change-[opacity] cursor-pointer lg:group-hover:opacity-100 lg:group-hover:z-[4]">
                            <div class="flex flex-col lg:w-1/2 px-[clamp(1rem,4vw,2rem)] self-end">
                                <h3 style="font-size: clamp(1rem, 7.5vw, 2rem)" class="font-bold mb-3 text-black text-center">OUR MISSION</h3>
                                <p style="font-size: clamp(0.6rem, 5vw, 1.25rem)" class="text-justify leading-relaxed">
                                    <strong style="font-size: clamp(0.6rem, 6.5vw,1.75rem)">To</strong> help women understand that physical fitness is crucial for healthy mind and body. To provide a comfortable and pleasant environment for women to continue their healthy and fitness journey
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="visionCard" class="visionMission hover-card group absolute  top-0 lg:relative w-[80vw] lg:w-[25vw] h-[80vh] lg:h-[70vh] lg:group-hover:z-[3] mt-8 lg:mt-0">
                    <div class="card__content relative transition-transform duration-1000 w-full h-full">
                        <picture id="visionImg" class="card__front cursor-pointer absolute top-0 left-0 lg:group-hover:z-[2]" style="box-shadow: 40px 85px 22px rgba(0, 0, 0, 0.25)">
                            <!-- AVIF versions -->
                            <source type="image/avif" srcset="
                                /custom_website/static/src/img/page_6/vision-640.avif 640w,
                                /custom_website/static/src/img/page_6/vision-768.avif 768w,
                                /custom_website/static/src/img/page_6/vision-1024.avif 1024w,
                                /custom_website/static/src/img/page_6/vision-1920.avif 1920w
                                " sizes="(max-width: 640px) 640px,
                                (max-width: 768px) 768px,
                                (max-width: 1024px) 1024px,
                                1920px" loading="lazy"/>
                            <!-- PNG fallback -->
                            <source type="image/png" srcset="
                                /custom_website/static/src/img/page_6/vision-640.png 640w,
                                /custom_website/static/src/img/page_6/vision-768.png 768w,
                                /custom_website/static/src/img/page_6/vision-1024.png 1024w,
                                /custom_website/static/src/img/page_6/vision-1920.png 1920w
                                " sizes="(max-width: 640px) 640px,
                                (max-width: 768px) 768px,
                                (max-width: 1024px) 1024px,
                                1920px" />
                            <!-- Fallback img with lazy loading -->
                            <img class="w-[80vw] lg:w-[25vw] h-[80vh] lg:h-[80vh] object-fill" 
                                 src="/custom_website/static/src/img/page_6/vision.png" 
                                 alt="vision" 
                                 loading="lazy" />
                        </picture>
                        <div id="vision" class="flex flex-col justify-center card__back w-[80vw] lg:w-[60vw] lg:py-10 h-[70vh] lg:h-[45vh] bottom-0 lg:bottom-[-5%] absolute bottom-0 left-0 lg:left-[-35vw] bg-[#AAABAB] lg:opacity-0 transition-opacity duration-[600ms] ease-out shadow-[0_20px_40px_rgba(0,0,0,0.3)] will-change-[opacity] cursor-pointer lg:group-hover:opacity-100 lg:group-hover:z-[1]">
                            <div class="flex flex-col lg:w-1/2 px-[clamp(1rem,4vw,2rem)]">
                                <h3 style="font-size: clamp(1rem, 7.5vw, 2rem)" class="font-bold mb-3 text-black text-center">OUR VISION</h3>
                                <p style="font-size: clamp(0.6rem, 5vw, 1.25rem)" class="text-justify leading-relaxed">
                                    <strong style="font-size: clamp(0.6rem, 6.5vw, 1.75rem)">To</strong> inspire and empower women in Saudi Arabia to lead healthier, happier lives by providing world-class fitness experiences in an environment of luxury, support, and community—contributing to the goals of Vision 2030.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>
    </data>
</odoo>