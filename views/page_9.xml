<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Page 9: Schedule Section -->
        <template id="aura_page_9" name="AuraCenter Page 9 - Schedule">
            <div class="flex-col flex items-center bg-no-repeat w-[100vw] h-[100vh] page-9 justify-center" id="page-9">
                <!-- Schedule Badge -->
                <div id="schedule_heading" class="text-center mb-1">
                    <div class="inline-block bg-[#c8e6dc] px-9 py-2 rounded-md">
                        <span class="text-[#2c3e50] font-bold text-black tracking-wider">SCHEDULE</span>
                    </div>
                </div>
                
                <!-- Main Title -->
                <div id="schedule_title" class="text-center mb-6">
                    <h1 class="text-3xl md:text-4xl font-bold text-black-800 leading-tight">
                        DISCIPLINE STARTS WITH A PLAN
                    </h1>
                </div>

                <!-- Weekly Schedule - 2 columns on mobile, full grid on desktop -->
                <div id="schedule" class="grid grid-cols-6 gap-2 mt-[3%] px-4">
                    <!-- Schedule days will be dynamically generated by JavaScript -->
                </div>
            </div>
        </template>
    </data>
</odoo>